# Bundler
/.bundle
/vendor/bundle/

# Environment files
.env
.env.*
!.env.example

# Logs
/log/*
!/log/.keep

# Temp
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/tmp/cache/*
!/tmp/cache/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Storage (Active Storage)
/storage/*
!/storage/.keep

# Rails encrypted credentials
/config/master.key
/config/credentials/*.key

# Node
/node_modules

# IDE
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db